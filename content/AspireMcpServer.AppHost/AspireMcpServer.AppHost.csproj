<Project Sdk="Aspire.AppHost.Sdk/13.4.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>aspire-mcp-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.4.0" />
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="13.4.0" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.McpInspector" Version="13.4.0" />
    <!-- Transitive pins: remediate vulnerabilities pulled in via Aspire.Hosting.*; remove once the Aspire packages reference safe versions. -->
    <PackageReference Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageReference Include="MessagePack" Version="2.5.301" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireMcpServer.McpServer\AspireMcpServer.McpServer.csproj" />
  </ItemGroup>

</Project>
